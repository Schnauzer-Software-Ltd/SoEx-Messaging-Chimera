<Project>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Package metadata (applied to any project that is packed). -->
  <PropertyGroup>
    <!-- Prerelease labels are compared as text when they contain a non-digit, and `alpha-N` is a single
         label: `alpha-10` sorts BELOW `alpha-9`, so the eleventh release would read as a downgrade to
         anything resolving the newest prerelease. The dot splits it into two labels and the second is
         purely numeric, which compares numerically. Keep the dot. -->
    <Version>0.0.0-alpha-1.0</Version>
    <Authors>Schnauzer Software Ltd</Authors>
    <Company>Schnauzer Software Ltd</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Schnauzer Software Ltd</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>messaging;events;sqlite;pubsub;durable;in-process</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
