<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Ships the XML docs in the packages for IntelliSense. A public member with no comment is a warning, and so
         a build error under -warnaserror. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package metadata (applied to any project that is packed). -->
  <PropertyGroup>
    <!-- Prerelease labels are compared as text when they contain a non-digit, so `rc-10` would sort BELOW
         `rc-9`. In `rc.N` the dot splits the label in two and the second part is purely numeric, which
         compares numerically. Keep the dot. -->
    <Version>1.0.0-rc.1</Version>
    <Authors>Schnauzer Software Ltd</Authors>
    <Company>Schnauzer Software Ltd</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Schnauzer Software Ltd</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>messaging;events;sqlite;pubsub;durable;in-process</PackageTags>
    <PackageProjectUrl>https://github.com/Schnauzer-Software-Ltd/SoEx-Messaging-Chimera</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Schnauzer-Software-Ltd/SoEx-Messaging-Chimera.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
