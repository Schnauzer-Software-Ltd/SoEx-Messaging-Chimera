<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SoEx.Messaging.Chimera.Testing</RootNamespace>
    <AssemblyName>SoEx.Messaging.Chimera.Testing</AssemblyName>
    <Description>Read-only inspection of Chimera subscribers and messages, for tests.</Description>
  </PropertyGroup>

  <!-- This reads the files' internals rather than its own copy of the schema. Two readers of one layout drift,
       and the one that drifts silently is the one nobody runs in production. It ships in lockstep with the
       engine for the same reason. -->
  <ItemGroup>
    <ProjectReference Include="../SoEx.Messaging.Chimera/SoEx.Messaging.Chimera.csproj" />
  </ItemGroup>

</Project>
