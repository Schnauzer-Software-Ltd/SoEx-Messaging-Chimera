<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SoEx.Messaging.Chimera</RootNamespace>
    <AssemblyName>SoEx.Messaging.Chimera.Abstractions</AssemblyName>
    <Description>Interfaces, options and message types for SoEx.Messaging.Chimera.</Description>
  </PropertyGroup>

  <!-- A delivery has to name the row it came from so it can be settled, but a handler has no business knowing
       whether that row was in the log, the scheduled table or this subscriber's own store. The type stays
       public so an envelope can be passed around; what it says is not. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SoEx.Messaging.Chimera" />
    <InternalsVisibleTo Include="SoEx.Messaging.Chimera.Core.Tests" />
    <InternalsVisibleTo Include="SoEx.Messaging.Chimera.Testing" />
  </ItemGroup>

</Project>
